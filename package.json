{
  "name": "@modulify/validator",
  "type": "module",
  "description": "Declarative validation util for JavaScript",
  "license": "MIT",
  "version": "0.3.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./assertions": {
      "import": {
        "types": "./dist/assertions.d.mts",
        "default": "./dist/assertions.mjs"
      },
      "require": {
        "types": "./dist/assertions.d.cts",
        "default": "./dist/assertions.cjs"
      },
      "default": "./dist/assertions.mjs"
    },
    "./combinators": {
      "import": {
        "types": "./dist/combinators.d.mts",
        "default": "./dist/combinators.mjs"
      },
      "require": {
        "types": "./dist/combinators.d.cts",
        "default": "./dist/combinators.cjs"
      },
      "default": "./dist/combinators.mjs"
    },
    "./json-schema": {
      "import": {
        "types": "./dist/json-schema.d.mts",
        "default": "./dist/json-schema.mjs"
      },
      "require": {
        "types": "./dist/json-schema.d.cts",
        "default": "./dist/json-schema.cjs"
      },
      "default": "./dist/json-schema.mjs"
    },
    "./predicates": {
      "import": {
        "types": "./dist/predicates.d.mts",
        "default": "./dist/predicates.mjs"
      },
      "require": {
        "types": "./dist/predicates.d.cts",
        "default": "./dist/predicates.cjs"
      },
      "default": "./dist/predicates.mjs"
    }
  },
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "typesVersions": {
    "*": {
      "assertions": [
        "./dist/assertions.d.ts"
      ],
      "combinators": [
        "./dist/combinators.d.ts"
      ],
      "json-schema": [
        "./dist/json-schema.d.ts"
      ],
      "predicates": [
        "./dist/predicates.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint src tests types scripts vite.config.ts release.config.mjs",
    "prepare": "husky",
    "release": "conventional-release --tags",
    "release:dry": "conventional-release --dry --verbose --tags",
    "release:minor": "conventional-release --tags --release-as minor",
    "release:patch": "conventional-release --tags --release-as patch",
    "release:major": "conventional-release --tags --release-as major",
    "stats": "gzip -c ./dist/index.mjs | wc -c",
    "test": "vitest run",
    "test:d": "vitest run --typecheck.only --coverage.enabled=false",
    "test:package": "yarn build && node scripts/check-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@modulify/conventional-release": "^0.1.3",
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "@vitest/ui": "5.0.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-dts": "^1.1.1",
    "vite": "^8.3.1",
    "vitest": "5.0.2"
  },
  "resolutions": {
    "minimatch@npm:10.2.1": "npm:10.2.4",
    "minimatch@npm:^9.0.3": "npm:9.0.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "types",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "logo.png"
  ],
  "keywords": [
    "validate",
    "validator",
    "ES2017"
  ],
  "contributors": [
    "Zaitsev Kirill <zaytsev.cmath10@gmail.com>"
  ],
  "homepage": "https://github.com/modulify/validator",
  "repository": {
    "type": "git",
    "url": "https://github.com/modulify/validator.git"
  },
  "packageManager": "yarn@4.12.0"
}
